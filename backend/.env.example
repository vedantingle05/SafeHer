# ========================================
# SafeHer Backend Environment Variables
# Copy this file to .env and fill in values
# ========================================

# Server
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# Supabase
# Get from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://ocurfsnqwgwuazsatbqu.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_JWT_SECRET=your_jwt_secret
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# WhatsApp Cloud API (Meta for Developers - Sends SOS audio/image/locations directly to WhatsApp)
# Get from: https://developers.facebook.com -> WhatsApp -> API Setup
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_ACCESS_

# Twilio SMS & Voice (Optional fallback)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Fast2SMS (Optional fallback for Indian numbers)
FAST2SMS_API_KEY=your_fast2sms_api_key

# Firebase Admin SDK (Optional)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
