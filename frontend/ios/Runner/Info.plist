<!-- ios/Runner/Info.plist — SafeHer iOS Config & Permissions -->
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleDisplayName</key>
    <string>SafeHer</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>SafeHer</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$(FLUTTER_BUILD_NAME)</string>
    <key>CFBundleVersion</key>
    <string>$(FLUTTER_BUILD_NUMBER)</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>UILaunchStoryboardName</key>
    <string>LaunchScreen</string>
    <key>UIMainStoryboardFile</key>
    <string>Main</string>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
    <key>UIViewControllerBasedStatusBarAppearance</key>
    <false/>

    <!-- ====== PERMISSIONS ====== -->

    <!-- Camera (evidence capture + facial emotion detection) -->
    <key>NSCameraUsageDescription</key>
    <string>SafeHer needs camera access to capture evidence during emergencies and detect facial expressions for distress monitoring.</string>

    <!-- Microphone (scream detection + audio recording) -->
    <key>NSMicrophoneUsageDescription</key>
    <string>SafeHer needs microphone access to detect screams and distress sounds, and to record audio evidence during emergencies.</string>

    <!-- Location (always — for background monitoring) -->
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>SafeHer needs your location to share it with emergency contacts when you need help.</string>
    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
    <string>SafeHer needs continuous location access to share your real-time location during emergencies, even when the app is in the background.</string>
    <key>NSLocationAlwaysUsageDescription</key>
    <string>SafeHer needs background location access to monitor your safety and share location during emergencies.</string>

    <!-- Motion sensors (fall detection) -->
    <key>NSMotionUsageDescription</key>
    <string>SafeHer uses motion sensors to detect falls and sudden movements that may indicate danger.</string>

    <!-- Photo library (save evidence) -->
    <key>NSPhotoLibraryUsageDescription</key>
    <string>SafeHer may save evidence photos to your library during emergencies.</string>

    <!-- Background modes -->
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
        <string>location</string>
        <string>fetch</string>
        <string>remote-notification</string>
        <string>processing</string>
    </array>

    <!-- Firebase -->
    <key>FirebaseAppDelegateProxyEnabled</key>
    <false/>
</dict>
</plist>
